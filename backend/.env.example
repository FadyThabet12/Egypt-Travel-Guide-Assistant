# Copy to `.env` and adjust. Every variable is optional (defaults shown).

# Where Ollama is listening (the LLM and the query embeddings run there)
OLLAMA_HOST=http://localhost:11434
# Chat model used to write answers (must be pulled: `ollama pull llama3.2`)
LLM_MODEL=llama3.2
# Seconds to wait for the LLM (CPU-only machines can be slow)
LLM_TIMEOUT=180
NUM_CTX=4096
TEMPERATURE=0.1

# Folder produced by notebooks/rag_pipeline.ipynb (section 2.7) - relative paths are relative to backend/
VECTOR_STORE_DIR=data/vector_store
# Leave these three empty to use the values stored in vector_store/config.json
# (embedding model, top-k and the calibrated refusal threshold)
# EMBED_MODEL=nomic-embed-text
# TOP_K=5
# MAX_DISTANCE=0.70

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:7860
LOG_LEVEL=INFO
